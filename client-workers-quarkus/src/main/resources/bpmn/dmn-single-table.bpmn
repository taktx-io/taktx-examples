<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_dmnSingleTable" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.1">
  <bpmn:process id="dmn-single-table" name="Credit Risk Assessment (Single DMN Table)" isExecutable="true">
    <bpmn:startEvent id="StartEvent_dmnSingle" name="Loan Application Received">
      <bpmn:outgoing>Flow_toEvaluateCreditRisk</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="evaluateCreditRisk" name="Evaluate Credit Risk">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="creditRiskAssessment" resultVariable="creditRiskResult" />
        <zeebe:ioMapping>
          <zeebe:input source="=700" target="creditScore" />
          <zeebe:input source="=15000" target="loanAmount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_toEvaluateCreditRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_toGatewayCreditRisk</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_creditDecision" name="Risk Decision?" default="Flow_02zeigc">
      <bpmn:incoming>Flow_toGatewayCreditRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_toDisburse</bpmn:outgoing>
      <bpmn:outgoing>Flow_toManualReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_toRejection</bpmn:outgoing>
      <bpmn:outgoing>Flow_02zeigc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="disburseLoan" name="Disburse Loan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="disburse-loan" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_toDisburse</bpmn:incoming>
      <bpmn:outgoing>Flow_toEndApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="assignManualReview" name="Assign to Reviewer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="assign-manual-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_toManualReview</bpmn:incoming>
      <bpmn:outgoing>Flow_toEndReview</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="sendRejectionNotice" name="Send Rejection Notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-rejection-notice" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_toRejection</bpmn:incoming>
      <bpmn:outgoing>Flow_toEndRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_approved" name="Loan Disbursed">
      <bpmn:incoming>Flow_toEndApproved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_review" name="Under Review">
      <bpmn:incoming>Flow_toEndReview</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_rejected" name="Application Rejected">
      <bpmn:incoming>Flow_toEndRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_toEvaluateCreditRisk" sourceRef="StartEvent_dmnSingle" targetRef="evaluateCreditRisk" />
    <bpmn:sequenceFlow id="Flow_toGatewayCreditRisk" sourceRef="evaluateCreditRisk" targetRef="Gateway_creditDecision" />
    <bpmn:sequenceFlow id="Flow_toDisburse" sourceRef="Gateway_creditDecision" targetRef="disburseLoan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditRiskResult.approved = true and creditRiskResult.requiresManualReview = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_toManualReview" sourceRef="Gateway_creditDecision" targetRef="assignManualReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditRiskResult.requiresManualReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_toRejection" sourceRef="Gateway_creditDecision" targetRef="sendRejectionNotice">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditRiskResult.approved = false and creditRiskResult.requiresManualReview = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_toEndApproved" sourceRef="disburseLoan" targetRef="EndEvent_approved" />
    <bpmn:sequenceFlow id="Flow_toEndReview" sourceRef="assignManualReview" targetRef="EndEvent_review" />
    <bpmn:sequenceFlow id="Flow_toEndRejected" sourceRef="sendRejectionNotice" targetRef="EndEvent_rejected" />
    <bpmn:endEvent id="Event_0kfghsp">
      <bpmn:incoming>Flow_02zeigc</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_02zeigc" sourceRef="Gateway_creditDecision" targetRef="Event_0kfghsp" />
    <bpmn:textAnnotation id="Ann_dmnRef">
      <bpmn:text>DMN: credit-risk-assessment.dmn
Decision: creditRiskAssessment
Result: creditRiskResult.{riskCategory, approved, requiresManualReview}</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_dmnRef" associationDirection="None" sourceRef="evaluateCreditRisk" targetRef="Ann_dmnRef" />
    <bpmn:textAnnotation id="Ann_inputs">
      <bpmn:text>Inputs (set inline):
creditScore = 700
loanAmount  = 15000</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_inputs" associationDirection="None" sourceRef="StartEvent_dmnSingle" targetRef="Ann_inputs" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_dmnSingle">
    <bpmndi:BPMNPlane id="BPMNPlane_dmnSingle" bpmnElement="dmn-single-table">
      <bpmndi:BPMNShape id="StartEvent_dmnSingle_di" bpmnElement="StartEvent_dmnSingle">
        <dc:Bounds x="239" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="217" y="255" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evaluateCreditRisk_di" bpmnElement="evaluateCreditRisk">
        <dc:Bounds x="340" y="190" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_creditDecision_di" bpmnElement="Gateway_creditDecision" isMarkerVisible="true">
        <dc:Bounds x="515" y="205" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="504" y="175" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="disburseLoan_di" bpmnElement="disburseLoan">
        <dc:Bounds x="640" y="190" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="assignManualReview_di" bpmnElement="assignManualReview">
        <dc:Bounds x="640" y="310" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sendRejectionNotice_di" bpmnElement="sendRejectionNotice">
        <dc:Bounds x="640" y="430" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_approved_di" bpmnElement="EndEvent_approved">
        <dc:Bounds x="812" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="791" y="255" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_review_di" bpmnElement="EndEvent_review">
        <dc:Bounds x="812" y="332" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="795" y="375" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_rejected_di" bpmnElement="EndEvent_rejected">
        <dc:Bounds x="812" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="803" y="495" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0kfghsp_di" bpmnElement="Event_0kfghsp">
        <dc:Bounds x="742" y="582" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann_dmnRef_di" bpmnElement="Ann_dmnRef">
        <dc:Bounds x="330" y="80" width="250" height="70" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann_inputs_di" bpmnElement="Ann_inputs">
        <dc:Bounds x="160" y="140" width="130" height="55" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_toEvaluateCreditRisk_di" bpmnElement="Flow_toEvaluateCreditRisk">
        <di:waypoint x="275" y="230" />
        <di:waypoint x="340" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toGatewayCreditRisk_di" bpmnElement="Flow_toGatewayCreditRisk">
        <di:waypoint x="440" y="230" />
        <di:waypoint x="515" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toDisburse_di" bpmnElement="Flow_toDisburse">
        <di:waypoint x="565" y="230" />
        <di:waypoint x="640" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toManualReview_di" bpmnElement="Flow_toManualReview">
        <di:waypoint x="540" y="255" />
        <di:waypoint x="540" y="350" />
        <di:waypoint x="640" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toRejection_di" bpmnElement="Flow_toRejection">
        <di:waypoint x="540" y="255" />
        <di:waypoint x="540" y="470" />
        <di:waypoint x="640" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toEndApproved_di" bpmnElement="Flow_toEndApproved">
        <di:waypoint x="740" y="230" />
        <di:waypoint x="812" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toEndReview_di" bpmnElement="Flow_toEndReview">
        <di:waypoint x="740" y="350" />
        <di:waypoint x="812" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toEndRejected_di" bpmnElement="Flow_toEndRejected">
        <di:waypoint x="740" y="470" />
        <di:waypoint x="812" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_dmnRef_di" bpmnElement="Assoc_dmnRef">
        <di:waypoint x="397" y="190" />
        <di:waypoint x="403" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_inputs_di" bpmnElement="Assoc_inputs">
        <di:waypoint x="257" y="212" />
        <di:waypoint x="247" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02zeigc_di" bpmnElement="Flow_02zeigc">
        <di:waypoint x="540" y="255" />
        <di:waypoint x="540" y="600" />
        <di:waypoint x="742" y="600" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
