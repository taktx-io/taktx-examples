# Default active profiles — starts all services when you run `docker compose up -d`.
# Override on the command line with --profile <name> to start only a subset:
#   docker compose --profile engine up -d          # Kafka + TaktX engine only
#   docker compose --profile observability up -d   # Kafka + Kafka UI + Grafana + Prometheus
#   docker compose --profile console up -d         # Kafka + console backend + frontend + nginx
COMPOSE_PROFILES=full

